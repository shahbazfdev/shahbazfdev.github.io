---
// src/components/home/Hero.astro
---
<section id="hero" class="relative min-h-screen flex items-center pt-16 overflow-hidden">
  <!-- Video Background -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none flex items-center justify-center bg-zinc-100 dark:bg-zinc-950">
    <div class="w-[300vw] lg:w-[150vw] absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-30 dark:opacity-20 mix-blend-luminosity">
      <div style="padding:56.25% 0 0 0;position:relative;width:100%;height:100%;">
        <iframe src="https://player.vimeo.com/video/1218689044?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479&amp;autoplay=1&amp;muted=1&amp;loop=1&amp;background=1" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="Video Background"></iframe>
      </div>
    </div>
    <div class="absolute inset-0 bg-white/60 dark:bg-zinc-950/70"></div>
  </div>

  <div id="hero-bg-1" class="absolute top-1/4 right-0 w-96 h-96 bg-accent/20 rounded-full blur-3xl pointer-events-none transition-transform duration-300 ease-out" aria-hidden="true"></div>
  <div id="hero-bg-2" class="absolute bottom-1/4 left-0 w-64 h-64 bg-zinc-200/50 dark:bg-zinc-800/40 rounded-full blur-3xl pointer-events-none transition-transform duration-300 ease-out" aria-hidden="true"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-6 py-24 w-full text-center flex flex-col items-center">
    <div class="w-full">
      <div class="flex flex-col items-center">
        <div class="reveal mb-6" data-tilt data-tilt-max="15" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.5">
          <img src="/profile.jpeg" alt="Profile Picture" class="w-32 h-32 md:w-40 md:h-40 rounded-full object-cover border-4 border-zinc-100 dark:border-zinc-800 shadow-xl mx-auto" />
        </div>
        <p class="reveal text-sm font-medium text-accent tracking-widest uppercase mb-4">Available for work</p>
        <h1 class="reveal d1 font-display font-bold text-5xl md:text-6xl lg:text-7xl leading-[1.05] tracking-tight text-zinc-900 dark:text-white mb-6">
          Hi, I'm <span class="text-accent">Shahbaz</span>
        </h1>
        <p class="reveal d2 text-lg md:text-xl text-zinc-500 dark:text-zinc-400 font-light leading-relaxed max-w-2xl mx-auto mb-10">
          <strong class="font-medium text-zinc-700 dark:text-zinc-300"><span id="typed-text"></span><span class="typed-cursor">|</span></strong>. I build intelligent systems, RAG pipelines, and high-performance applications that solve complex real-world problems.
        </p>
        <div class="reveal d3 flex flex-wrap justify-center gap-4">
          <a href="#work" class="shimmer magnetic inline-flex items-center gap-2 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 font-medium px-7 py-3.5 rounded-full hover:bg-zinc-700 dark:hover:bg-zinc-200 transition-colors text-sm">
            View my work
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <a href="/contact" class="magnetic inline-flex items-center gap-2 border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-medium px-7 py-3.5 rounded-full hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors text-sm">Get in touch</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const roles = ["AI & ML Researcher", "Software Engineer", "Problem Solver"];
  let roleIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let typeTimeout;
  
  const typeText = () => {
    const el = document.getElementById('typed-text');
    if (!el) return;
    
    const currentRole = roles[roleIndex];
    
    if (isDeleting) {
      el.textContent = currentRole.substring(0, charIndex - 1);
      charIndex--;
    } else {
      el.textContent = currentRole.substring(0, charIndex + 1);
      charIndex++;
    }
    
    let typeSpeed = isDeleting ? 50 : 100;
    
    if (!isDeleting && charIndex === currentRole.length) {
      typeSpeed = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      roleIndex = (roleIndex + 1) % roles.length;
      typeSpeed = 500;
    }
    
    typeTimeout = setTimeout(typeText, typeSpeed);
  };

  const trackMouse = () => {
    const hero = document.getElementById('hero');
    const bg1 = document.getElementById('hero-bg-1');
    const bg2 = document.getElementById('hero-bg-2');
    if (!hero || !bg1 || !bg2) return;

    hero.addEventListener('mousemove', (e) => {
      const x = e.clientX / window.innerWidth - 0.5;
      const y = e.clientY / window.innerHeight - 0.5;
      
      bg1.style.transform = `translate(${x * 60}px, ${y * 60}px)`;
      bg2.style.transform = `translate(${x * -50}px, ${y * -50}px)`;
    });
  };

  const initHero = () => {
    clearTimeout(typeTimeout);
    roleIndex = 0;
    charIndex = 0;
    isDeleting = false;
    const el = document.getElementById('typed-text');
    if (el) el.textContent = '';
    typeText();
    trackMouse();
  };

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
<script is:inline src="https://player.vimeo.com/api/player.js"></script>
